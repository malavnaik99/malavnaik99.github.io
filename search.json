---
layout: null
sitemap: false
permalink: /search.json
---
{%- assign out = "" | split: "" -%}
[
{%- for p in site.posts -%}
  {"t": {{ p.title | jsonify }}, "u": {{ p.url | relative_url | jsonify }}, "d": {{ p.description | jsonify }}, "k": "Post · {{ p.date | date: '%-d %b %Y' }}", "x": {{ p.tags | join: " " | jsonify }}},
{%- endfor -%}
{%- assign projects = site.projects | sort: "order" -%}
{%- for p in projects -%}
  {%- capture x %}{{ p.description }} {{ p.tech | join: " " }}{% endcapture %}
  {"t": {{ p.title | jsonify }}, "u": {{ p.url | relative_url | jsonify }}, "d": {{ p.summary | default: p.description | jsonify }}, "k": "Project", "x": {{ x | jsonify }}},
{%- endfor -%}
{%- for p in site.html_pages -%}{%- if p.title and p.sitemap != false and p.redirect_to == nil and p.url != "/" -%}
  {"t": {{ p.title | jsonify }}, "u": {{ p.url | relative_url | jsonify }}, "d": {{ p.description | jsonify }}, "k": "Page"},
{%- endif -%}{%- endfor -%}
  {"t": "Home", "u": "/", "d": {{ site.description | jsonify }}, "k": "Page"}
]
