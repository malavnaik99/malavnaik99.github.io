sform: uppercase; color: var(--accent); margin: 0; }\n    /* header */\n    .site-header { position: sticky; top: 0; z-index: 10; background: var(--bg); border-bottom: 1px solid var(--line); }\n    .site-header .container { display: flex; align-items: center; gap: 1rem; min-height: 3.75rem; flex-wrap: wrap; }\n    .brand { font: 700 1.1rem/1 \"Source Serif 4\", Georgia, serif; color: var(--text); text-decoration: none; margin-right: auto; }\n    .site-nav ul { display: flex; gap: .25rem 1.25rem; list-style: none; margin: 0; padding: 0; font-size: .95rem; }\n    .site-nav a { color: var(--muted); text-decoration: none; } .site-nav a:hover, .site-nav a[aria-current] { color: var(--text); }\n    .site-nav a[aria-current] { font-weight: 600; }\n    .icon-btn { background: none; border: 1px solid var(--line); color: var(--text); border-radius: 8px; height: 2.25rem; min-width: 2.25rem; display: inline-flex; align-items: center; justify-content: center; gap: .4rem; cursor: pointer; font: 500 .9rem Inter, sans-serif; padding: 0 .5rem; }\n    .icon-btn svg { width: 1.1rem; height: 1.1rem; }\n    .menu-btn { display: none; }\n    @media (max-width: 760px) {\n      .js .menu-btn { display: inline-flex; }\n      .js .site-nav { order: 3; flex-basis: 100%; display: none; } .js .site-nav.open { display: block; }\n      .site-nav ul { flex-wrap: wrap; padding: .25rem 0 .75rem; } .js .site-nav ul { flex-direction: column; gap: 0; }\n      .js .site-nav a { display: block; padding: .6rem 0; border-top: 1px solid var(--line); }\n    }\n    .theme-dark-icon { display: none; }\n    :root[data-theme\u003d\"dark\"] .theme-dark-icon { display: block; } :root[data-theme\u003d\"dark\"] .theme-light-icon { display: none; }\n    @media (prefers-color-scheme: dark) { :root:not([data-theme\u003d\"light\"]) .theme-dark-icon { display: block; } :root:not([data-theme\u003d\"light\"]) .theme-light-icon { display: none; } }\n    .no-js-hide { display: none; } .js .no-js-hide { display: inline-flex; }\n    /* buttons, cards, chips */\n    .btn { display: inline-block; padding: .65rem 1.1rem; border-radius: 8px; border: 1px solid var(--line); color: var(--text); text-decoration: none; font-weight: 600; font-size: .95rem; }\n    .btn-primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }\n    .btn:hover { text-decoration: none; filter: brightness(1.05); }\n    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1.25rem; list-style: none; padding: 0; margin: 1rem 0; }\n    .card { border: 1px solid var(--line); border-radius: 12px; padding: 1.25rem 1.35rem; background: var(--bg); }\n    .card h3 { margin: .2rem 0 .5rem; font-size: 1.2rem; } .card h3 a { color: var(--text); text-decoration: none; } .card h3 a:hover { color: var(--accent); }\n    .card p { margin: 0 0 .6rem; font-size: .95rem; line-height: 1.6; }\n    .meta { font-size: .85rem; color: var(--muted); margin: 0; }\n    .tag { display: inline-block; font-size: .78rem; font-weight: 600; color: var(--accent); background: var(--accent-soft); border-radius: 99px; padding: .05rem .6rem; text-decoration: none; }\n    .chips { display: flex; flex-wrap: wrap; gap: .4rem; padding: 0; margin: .6rem 0; list-style: none; }\n    .chips li { border: 1px solid var(--line); border-radius: 99px; padding: .05rem .65rem; font-size: .8rem; color: var(--muted); }\n    .chips a { color: inherit; text-decoration: none; }\n    .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: 3rem; }\n    .section-head h2 { margin: 0; } .section-head a { font-size: .95rem; }\n    /* prose */\n    .prose p, .prose li { overflow-wrap: break-word; }\n    pre { position: relative; overflow-x: auto; background: var(--surface); border: 1px solid var(--line); padding: 1rem; border-radius: 8px; font-size: .85rem; line-height: 1.55; }\n    code { font: .88em ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; } :not(pre) \u003e code { background: var(--surface); padding: .1em .35em; border-radius: 4px; }\n    .highlight .k, .highlight .kd, .highlight .kn, .highlight .kr, .highlight .kc, .highlight .ow, .highlight .nt { color: var(--c-key); }\n    .highlight .s, .highlight .s1, .highlight .s2, .highlight .sd, .highlight .sb { color: var(--c-str); }\n    .highlight .c, .highlight .c1, .highlight .cm, .highlight .ch, .highlight .cs { color: var(--c-com); font-style: italic; }\n    .highlight .m, .highlight .mi, .highlight .mf, .highlight .kt { color: var(--c-num); } .highlight .nf, .highlight .nb, .highlight .na { color: var(--c-fn); }\n    .copy-btn { position: absolute; top: .4rem; right: .4rem; font: 500 .75rem Inter, sans-serif; background: var(--bg); color: var(--text); border: 1px solid var(--line); border-radius: 6px; padding: .2rem .5rem; cursor: pointer; }\n    table { border-collapse: collapse; display: block; overflow-x: auto; font-size: .92rem; margin: 1rem 0; }\n    td, th { border-bottom: 1px solid var(--line); padding: .45rem .7rem; text-align: left; vertical-align: top; } th { font-weight: 600; }\n    blockquote { margin: 1.25rem 0; padding: .1rem 1.1rem; border-left: 3px solid var(--accent); color: var(--muted); }\n    hr { border: 0; border-top: 1px solid var(--line); margin: 2.5rem 0; }\n    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n    /* home */\n    .hero { display: grid; grid-template-columns: 220px 1fr; gap: 2.5rem; align-items: center; }\n    .hero img { width: 220px; height: 220px; object-fit: cover; border-radius: 50%; }\n    .hero h1 { margin: .1em 0 .1em; } .hero .lead { font-size: 1.3rem; color: var(--text); font-weight: 500; }\n    .proof { list-style: none; padding: 0; margin: 1.2rem 0; display: grid; gap: .5rem; font-size: .98rem; }\n    .proof li { padding-left: 1.1rem; position: relative; } .proof li::before { content: \"\"; position: absolute; left: 0; top: .7em; width: .45rem; height: .45rem; border-radius: 2px; background: var(--accent); }\n    .actions { display: flex; flex-wrap: wrap; gap: .6rem; margin: 1.2rem 0 0; }\n    @media (max-width: 760px) { .hero { grid-template-columns: 1fr; gap: 1.25rem; } .hero img { width: 128px; height: 128px; } }\n    .lab { margin-top: 3rem; } .lab h2 { margin-top: 0; font-size: 1.3rem; }\n    .filters { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0 .5rem; }\n    .filters .btn[aria-pressed\u003d\"true\"] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }\n    .case dl { margin: .4rem 0 .6rem; font-size: .92rem; line-height: 1.55; } .case dt { font-weight: 600; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-top: .6rem; } .case dd { margin: .1rem 0 0; }\n    /* posts */\n    .lead { font-size: 1.15rem; color: var(--muted); margin: 0 0 .8rem; }\n    .tldr { background: var(--accent-soft); border-left: 3px solid var(--accent); border-radius: 0 8px 8px 0; padding: .8rem 1.1rem; margin: 1.5rem 0; }\n    .tldr p:last-child { margin-bottom: 0; }\n    .toc { border: 1px solid var(--line); border-radius: 8px; padding: .8rem 1.1rem; margin: 1.5rem 0; font-size: .95rem; } .toc ol { margin: .3rem 0 0; padding-left: 1.2rem; }\n    .share { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin: 2rem 0; } .btn.small { padding: .35rem .75rem; font-size: .85rem; cursor: pointer; background: var(--bg); }\n    .author { display: flex; gap: 1rem; align-items: flex-start; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 1.25rem 0; margin: 2rem 0; }\n    .author img { width: 72px; height: 72px; object-fit: cover; border-radius: 50%; flex: none; } .author p { margin: 0 0 .3rem; font-size: .95rem; line-height: 1.6; }\n    ul.plain { list-style: none; padding: 0; } ul.plain li { margin: 0 0 1rem; }\n    /* footer */\n    .site-footer { border-top: 1px solid var(--line); padding: 2rem 0 3rem; font-size: .9rem; color: var(--muted); }\n    .site-footer ul { display: flex; flex-wrap: wrap; gap: .3rem 1.1rem; padding: 0; margin: .4rem 0 1rem; list-style: none; }\n    .site-footer a { color: var(--muted); } .site-footer a:hover { color: var(--text); }\n    @page { margin: 12mm 14mm; }\n    @media print { .site-header, .site-footer, .noprint { display: none; } body { font-size: 10pt; line-height: 1.45; } main { padding: 0; } h1 { font-size: 18pt; margin: 0 0 .3rem; } h2 { font-size: 12.5pt; margin: .9rem 0 .3rem; } p, ul, dl { margin: .3rem 0; } a { color: inherit; } }\n  \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n  \u003ca class\u003d\"skip\" href\u003d\"#main\"\u003eSkip to content\u003c/a\u003e\n  \u003cheader class\u003d\"site-header\"\u003e\n    \u003cdiv class\u003d\"container\"\u003e\n      \u003ca class\u003d\"brand\" href\u003d\"/\"\u003eMalav Naik\u003c/a\u003e\n      \u003cbutton class\u003d\"icon-btn theme-btn no-js-hide\" type\u003d\"button\" aria-label\u003d\"Switch between light and dark theme\"\u003e\n        \u003csvg class\u003d\"theme-light-icon\" viewBox\u003d\"0 0 24 24\" fill\u003d\"none\" stroke\u003d\"currentColor\" stroke-width\u003d\"2\" aria-hidden\u003d\"true\"\u003e\u003cpath d\u003d\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\"/\u003e\u003c/svg\u003e\n        \u003csvg class\u003d\"theme-dark-icon\" viewBox\u003d\"0 0 24 24\" fill\u003d\"none\" stroke\u003d\"currentColor\" stroke-width\u003d\"2\" aria-hidden\u003d\"true\"\u003e\u003ccircle cx\u003d\"12\" cy\u003d\"12\" r\u003d\"4\"/\u003e\u003cpath d\u003d\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/\u003e\u003c/svg\u003e\n      \u003c/button\u003e\n      \u003cbutton class\u003d\"icon-btn menu-btn\" type\u003d\"button\" aria-expanded\u003d\"false\" aria-controls\u003d\"site-nav\"\u003eMenu\u003c/button\u003e\n      \u003cnav class\u003d\"site-nav\" id\u003d\"site-nav\" aria-label\u003d\"Main\"\u003e\n        \u003cul\u003e\n        \n        \n          \u003cli\u003e\u003ca href\u003d\"/\"\u003eHome\u003c/a\u003e\u003c/li\u003e\n        \n          \u003cli\u003e\u003ca href\u003d\"/blog/\" aria-current\u003d\"page\"\u003eBlog\u003c/a\u003e\u003c/li\u003e\n        \n          \u003cli\u003e\u003ca href\u003d\"/projects/\"\u003eProjects\u003c/a\u003e\u003c/li\u003e\n        \n          \u003cli\u003e\u003ca href\u003d\"/about/\"\u003eAbout\u003c/a\u003e\u003c/li\u003e\n        \n          \u003cli\u003e\u003ca href\u003d\"/resume/\"\u003eRésumé\u003c/a\u003e\u003c/li\u003e\n        \n          \u003cli\u003e\u003ca href\u003d\"/contact/\"\u003eContact\u003c/a\u003e\u003c/li\u003e\n        \n        \u003c/ul\u003e\n      \u003c/nav\u003e\n    \u003c/div\u003e\n  \u003c/header\u003e\n  \u003cmain id\u003d\"main\"\u003e\n    \u003cdiv class\u003d\"container\"\u003e\n      \u003cdiv class\u003d\"prose\"\u003e\n\u003carticle\u003e\n  \u003cheader\u003e\n    \u003cp class\u003d\"eyebrow\"\u003e\u003ca href\u003d\"/blog/series/trust-safety/\"\u003eTrust \u0026 safety\u003c/a\u003e\u003c/p\u003e\n    \u003ch1\u003ePrecision vs Recall in Content Moderation: The Trade-Off Every Integrity Team Faces\u003c/h1\u003e\n    \u003cp class\u003d\"lead\"\u003eWhy no moderation system can catch everything without hurting innocent users, and how to choose where to set the line.\u003c/p\u003e\n    \u003cp class\u003d\"meta\"\u003ePublished \u003ctime datetime\u003d\"2026-10-20T00:00:00+00:00\"\u003e20 October 2026\u003c/time\u003e\n      · Updated \u003ctime datetime\u003d\"2026-10-20T00:00:00+00:00\"\u003e20 October 2026\u003c/time\u003e\n      · 2 min read · by \u003ca href\u003d\"/about/\"\u003eMalav Naik\u003c/a\u003e\u003c/p\u003e\n  \u003c/header\u003e\n  \n  \n  \u003cnav class\u003d\"toc\" aria-label\u003d\"Contents\"\u003e\u003cp class\u003d\"eyebrow\"\u003eContents\u003c/p\u003e\u003col\u003e\n    \u003cli\u003e\u003ca href\u003d\"#the-two-numbers\"\u003eThe two numbers\u003c/a\u003e\u003c/li\u003e\n    \u003cli\u003e\u003ca href\u003d\"#why-the-right-threshold-depends-on-the-harm\"\u003eWhy the “right” threshold depends on the harm\u003c/a\u003e\u003c/li\u003e\n    \u003cli\u003e\u003ca href\u003d\"#the-human-review-layer-changes-the-maths\"\u003eThe human review layer changes the maths\u003c/a\u003e\u003c/li\u003e\n    \u003cli\u003e\u003ca href\u003d\"#measure-on-the-right-sample\"\u003eMeasure on the right sample\u003c/a\u003e\u003c/li\u003e\n    \u003cli\u003e\u003ca href\u003d\"#practical-advice\"\u003ePractical advice\u003c/a\u003e\u003c/li\u003e\n    \u003c/ol\u003e\u003c/nav\u003e\n  \u003cdiv class\u003d\"post-body\"\u003e\n    \u003cp\u003e\u003cimg fetchpriority\u003d\"high\" decoding\u003d\"async\" src\u003d\"/images/malav-naik-convention-centre-dublin-suit.jpg\" alt\u003d\"Malav Naik in a suit outside a curved glass building – Precision vs Recall in Content Moderation: The Trade-Off Every Integrity Team Faces\" width\u003d\"1200\" height\u003d\"1599\" /\u003e\u003c/p\u003e\n\u003cp\u003eEvery system that decides “is this content harmful?” makes two kinds of mistakes. It removes things that were fine, and it misses things that weren’t. You can’t drive both to zero. Choosing which mistake you’d rather make is one of the most important decisions an integrity team takes.\u003c/p\u003e\n\u003ch2 id\u003d\"the-two-numbers\"\u003eThe two numbers\u003c/h2\u003e\n\u003cul\u003e\n  \u003cli\u003e\u003cstrong\u003ePrecision\u003c/strong\u003e: of everything the system flagged, how much was actually violating? Low precision means innocent users get actioned.\u003c/li\u003e\n  \u003cli\u003e\u003cstrong\u003eRecall\u003c/strong\u003e: of everything that was actually violating, how much did the system catch? Low recall means harm stays up.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eRaise the threshold for flagging and precision goes up while recall goes down. Lower it and the reverse happens.\u003c/p\u003e\n\u003ch2 id\u003d\"why-the-right-threshold-depends-on-the-harm\"\u003eWhy the “right” threshold depends on the harm\u003c/h2\u003e\n\u003cp\u003eThere is no universal setting. It depends on the cost of each error:\u003c/p\u003e\n\u003ctable\u003e\n  \u003cthead\u003e\n    \u003ctr\u003e\n      \u003cth\u003eHarm type\u003c/th\u003e\n      \u003cth\u003eCost of a miss\u003c/th\u003e\n      \u003cth\u003eCost of a false positive\u003c/th\u003e\n      \u003cth\u003eUsual bias\u003c/th\u003e\n    \u003c/tr\u003e\n  \u003c/thead\u003e\n  \u003ctbody\u003e\n    \u003ctr\u003e\n      \u003ctd\u003eChild safety, imminent violence\u003c/td\u003e\n      \u003ctd\u003eSevere, possibly irreversible\u003c/td\u003e\n      \u003ctd\u003eUser annoyance, appeal\u003c/td\u003e\n      \u003ctd\u003eFavour recall\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003eSpam\u003c/td\u003e\n      \u003ctd\u003eMild irritation\u003c/td\u003e\n      \u003ctd\u003eLost legitimate post\u003c/td\u003e\n      \u003ctd\u003eBalanced\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003eSatire, political speech\u003c/td\u003e\n      \u003ctd\u003eLow\u003c/td\u003e\n      \u003ctd\u003eCensorship concerns, trust loss\u003c/td\u003e\n      \u003ctd\u003eFavour precision\u003c/td\u003e\n    \u003c/tr\u003e\n  \u003c/tbody\u003e\n\u003c/table\u003e\n\u003ch2 id\u003d\"the-human-review-layer-changes-the-maths\"\u003eThe human review layer changes the maths\u003c/h2\u003e\n\u003cp\u003eMost teams don’t rely on a single automated decision. A common pattern:\u003c/p\u003e\n\u003col\u003e\n  \u003cli\u003e\u003cstrong\u003eHigh-confidence violations\u003c/strong\u003e: action automatically.\u003c/li\u003e\n  \u003cli\u003e\u003cstrong\u003eUncertain middle\u003c/strong\u003e: send to human reviewers.\u003c/li\u003e\n  \u003cli\u003e\u003cstrong\u003eHigh-confidence benign\u003c/strong\u003e: leave alone.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eNow the question becomes how wide to make the middle band. Wider means better decisions but more review cost and slower action. This is where the work becomes an operations problem as much as a modelling one.\u003c/p\u003e\n\u003ch2 id\u003d\"measure-on-the-right-sample\"\u003eMeasure on the right sample\u003c/h2\u003e\n\u003cp\u003ePrecision is easy to measure: sample what you flagged and check it. Recall is hard, because you need to find what you \u003cem\u003edidn’t\u003c/em\u003e flag. That requires sampling the unflagged population, which is usually huge and mostly benign. Teams that only measure precision tend to drift towards under-enforcement without noticing.\u003c/p\u003e\n\u003ch2 id\u003d\"practical-advice\"\u003ePractical advice\u003c/h2\u003e\n\u003cul\u003e\n  \u003cli\u003eReport precision and recall per harm category, never as one blended number.\u003c/li\u003e\n  \u003cli\u003eTrack appeal overturn rates as a real-world check on precision.\u003c/li\u003e\n  \u003cli\u003eRevisit thresholds when content patterns change. A threshold tuned last year may be wrong today.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eIn the next trust and safety post I’ll look at prevalence: the metric that tries to answer “how much harm do users actually see?”\u003c/p\u003e\n\u003cp\u003e\u003cem\u003eViews are my own and use public, general examples only.\u003c/em\u003e\u003c/p\u003e\n  \u003c/div\u003e\n  \n  \n  \u003cul class\u003d\"chips\" aria-label\u003d\"Tags\"\u003e\u003cli\u003e\u003ca href\u003d\"/blog/topics/#tag-trustandsafety\"\u003e#trustandsafety\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href\u003d\"/blog/topics/#tag-machinelearning\"\u003e#machinelearning\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href\u003d\"/blog/topics/#tag-metrics\"\u003e#metrics\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href\u003d\"/blog/topics/#tag-ai\"\u003e#ai\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\n  \n  \n  \u003cp class\u003d\"share small\"\u003eShare:\n    \u003ca class\u003d\"btn small\" href\u003d\"https://www.linkedin.com/sharing/share-offsite/?url\u003dhttp%3A%2F%2Flocalhost%3A8080%2Fblog%2Fprecision-recall-content-moderation%2F\" rel\u003d\"noopener\"\u003eLinkedIn\u003c/a\u003e\n    \u003ca class\u003d\"btn small\" href\u003d\"https://x.com/intent/post?url\u003dhttp%3A%2F%2Flocalhost%3A8080%2Fblog%2Fprecision-recall-content-moderation%2F\u0026amp;text\u003dPrecision+vs+Recall+in+Content+Moderation%3A+The+Trade-Off+Every+Integrity+Team+Faces\" rel\u003d\"noopener\"\u003eX\u003c/a\u003e\n    \u003cspan data-copy-link\u003e\u003c/span\u003e\n  \u003c/p\u003e\n  \u003caside class\u003d\"author\" aria-label\u003d\"About the author\"\u003e\n  \u003cimg src\u003d\"/images/malav-naik-portrait.jpg\" alt\u003d\"Malav Naik\" width\u003d\"72\" height\u003d\"72\" loading\u003d\"lazy\"\u003e\n  \u003cdiv\u003e\n    \u003cp\u003e\u003cstrong\u003e\u003ca href\u003d\"/about/\"\u003eMalav Naik\u003c/a\u003e\u003c/strong\u003e builds data pipelines, GenAI tools and AI automation in Dublin, and writes about them here.\u003cbr\u003e\n    He is an Escalation Operations Analyst – Platform Integrity at Accenture, for a global technology client.\u003c/p\u003e\n    \u003cp class\u003d\"small\"\u003e\u003ca href\u003d\"https://www.linkedin.com/in/malav-naik\" rel\u003d\"me\"\u003eLinkedIn\u003c/a\u003e · \u003ca href\u003d\"https://github.com/malavnaik99\" rel\u003d\"me\"\u003eGitHub\u003c/a\u003e · \u003ca href\u003d\"/about/\"\u003eAbout\u003c/a\u003e\u003c/p\u003e\n  \u003c/div\u003e\n\u003c/aside\u003e\n\u003c/article\u003e\n\u003csection aria-labelledby\u003d\"related\"\u003e\n  \u003ch2 id\u003d\"related\"\u003eRelated posts\u003c/h2\u003e\n  \u003cul class\u003d\"plain\"\u003e\u003cli\u003e\u003ca href\u003d\"/blog/masters-in-ireland-after-industry/\"\u003eWhat a Master\u0027s in Ireland Taught Me After Nine Years in Industry\u003c/a\u003e\u003cbr\u003e\u003cspan class\u003d\"meta\"\u003e20 Oct 2026\u003c/span\u003e\u003c/li\u003e\u003